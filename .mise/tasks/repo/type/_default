#!/usr/bin/env bash
#
# Check Python and frontend types.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check Python and frontend types."
set -euo pipefail

# main - Check Python and frontend types.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  mise run repo:type:python
  mise run repo:type:frontend
}

main "$@"
