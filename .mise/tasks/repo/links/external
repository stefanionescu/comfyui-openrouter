#!/usr/bin/env bash
#
# Check links to public documentation.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check links to public documentation."
set -euo pipefail

# main - Check links to public documentation.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  exec bun quality/repository/links.mjs --external "$@"
}

main "$@"
