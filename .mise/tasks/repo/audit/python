#!/usr/bin/env bash
#
# Audit locked Python packages using public advisories.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Audit locked Python packages using public advisories."
set -euo pipefail

# main - Audit locked Python packages using public advisories.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  bash quality/security/pip-audit/run.sh
  bash quality/security/osv/run.sh python
}

main "$@"
