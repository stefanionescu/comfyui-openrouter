#!/usr/bin/env bash
#
# Print the registered node descriptions as JSON, as the workflow build reads them.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Print the registered node descriptions as JSON, as the workflow build reads them."
set -euo pipefail

# main - Print the registered node descriptions as JSON, as the workflow build reads them.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1
  exec uv run --no-sync python -m scripts.nodes.check --export "$@"
}
main "$@"
