#!/usr/bin/env bash
#
# Build browser files for ComfyUI.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Build browser files for ComfyUI."
set -euo pipefail

# main - Build browser files for ComfyUI.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  exec uv run --no-sync python -m scripts.frontend "$@"
}

main "$@"
