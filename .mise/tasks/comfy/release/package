#!/usr/bin/env bash
#
# Run local and network checks, then pack and inspect the official node.zip.
# Runtime: Bash 3.2+ on macOS or Linux.
#MISE description="Run local and network checks, then pack and inspect the official node.zip."
set -euo pipefail

# main - Run local and network checks, then pack and inspect the official node.zip.
main() {
    REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
    cd "${REPO_ROOT}" || exit 1

    bun run --no-install gspot check
    comfy node pack "$@"
    unzip -l node.zip
    mise --cd .gspot exec -- gitleaks dir "${REPO_ROOT}/node.zip" \
        --config "${REPO_ROOT}/.gspot/configurations/general/secrets/gitleaks.toml" \
        --max-archive-depth 3 \
        --no-banner \
        --redact \
        --ignore-gitleaks-allow
}

main "$@"
