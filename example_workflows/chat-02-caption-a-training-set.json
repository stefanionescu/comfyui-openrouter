      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "1. Set your key in **ComfyUI menu → Extensions → OpenRouter → OpenRouter settings**.\n2. In **Load Image (from Folder)**, choose a folder of images in ComfyUI's input folder.\n3. Press **Run**. Each image and its caption are saved to `output/captions`.\n\nEach image sends two paid requests, a caption and a check, so a folder of 20 images sends 40. See prices at openrouter.ai/models and charges at openrouter.ai/activity."
      ],
      "title": "Start Here"
    },
