      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "GPT-6 Sol reads both photos and the spec sheet, and writes the listing as JSON: a title, five bullet points, and a price. GPT-6 Luna lists the facts in the spec sheet for **Check**.\n\nOpen **Write** to change what each model is asked. Two paid requests."
      ],
      "title": "Note"
    },
