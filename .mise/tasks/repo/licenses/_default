#!/usr/bin/env bash
#
# Check Python and frontend dependency licenses.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check Python and frontend dependency licenses."
set -euo pipefail

# main - Check Python and frontend dependency licenses.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  uv run --no-sync python -m quality.repository.licenses.check
  bash quality/repository/licenses/check.sh
}

main "$@"
