#!/usr/bin/env bash
#
# Check repository structure, naming, and policy.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check repository structure, naming, and policy."
set -euo pipefail

# main - Check repository structure, naming, and policy.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  policy_scope="all"
  while (($# > 0)); do
    case "$1" in
      --scope)
        (($# >= 2)) || exit 2
        policy_scope="$2"
        shift 2
        ;;
      *)
        printf 'error: unknown policy argument: %s\n' "$1" >&2
        exit 2
        ;;
    esac
  done
  case "${policy_scope}" in
    all | staged) ;;
    *)
      printf 'error: --scope must be all or staged, got %s\n' "${policy_scope}" >&2
      exit 2
      ;;
  esac

  uv run --no-sync python -m quality.repository.integrity.config
  uv run --no-sync python -m quality.repository.integrity.folder
  uv run --no-sync python -m quality.repository.integrity.policies
  uv run --no-sync python -m quality.repository.integrity.typecheck
  uv run --no-sync python -m quality.repository.naming.runner --scope "${policy_scope}"
  uv run --no-sync python -m quality.repository.functions.runner --scope "${policy_scope}"
  uv run --no-sync python -m quality.repository.integrity.suppressions --scope "${policy_scope}"
}

main "$@"
