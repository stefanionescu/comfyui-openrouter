{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [
        "**/build/**",
        "plans/**",
        "**/.venv/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "**/*.py[cod]",
        "**/.ruff_cache/**",
        "dist/**",
        ".cache/**",
        "**/.artifacts/**",
        "**/.import_linter_cache/**",
        "**/node.zip",
        "**/.env",
        "**/.env.*",
        "**/.mise.local.toml",
        "**/*.log",
        "**/.DS_Store",
        ".gspot/**",
        ".stylelintrc.json",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        "ruff.toml",
        "pyrightconfig.json",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "web/extension.js",
        "web/extension.css",
        "example_workflows/*.json",
        "subgraphs/*.json",
        "**/requirements.txt",
        "**/bower_components/**",
        "**/venv/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/uv.lock",
        "**/.env*"
    ],
    "ignoreDependencies": [
        "@gspothq/cli",
        "@eslint/js",
        "@gspothq/eslint-plugin",
        "ajv",
        "basedpyright",
        "@commitlint/cli",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-barrel-files",
        "eslint-plugin-boundaries",
        "eslint-plugin-import-x",
        "eslint-plugin-jsdoc",
        "eslint-plugin-n",
        "eslint-plugin-package-json",
        "eslint-plugin-perfectionist",
        "eslint-plugin-regexp",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-unicorn",
        "globals",
        "jscpd",
        "knip",
        "markdownlint-cli2",
        "picomatch",
        "prettier",
        "stylelint",
        "stylelint-config-standard",
        "syncpack",
        "typescript",
        "typescript-eslint",
        "v8r"
    ],
    "ignoreBinaries": [
        "basedpyright",
        "commitlint",
        "deptry",
        "editorconfig-checker",
        "eslint",
        "gitleaks",
        "jscpd",
        "knip",
        "lychee",
        "markdownlint-cli2",
        "node",
        "osv-scanner",
        "prettier",
        "pydoclint",
        "ruff",
        "semgrep",
        "shellcheck",
        "shfmt",
        "stylelint",
        "syncpack",
        "taplo",
        "tsc",
        "typos",
        "uv",
        "v8r",
        "vale",
        "vulture",
        "bun"
    ],
    "ignoreExportsUsedInFile": false,
    "workspaces": {
        ".": {
            "entry": [
                "web/scripts/extension.ts",
                "src/main.{ts,js}",
                "src/index.{ts,js}",
                "**/test/**",
                "**/tests/**",
                "**/__tests__/**",
                "**/*.test.*",
                "**/*.spec.*",
                "**/test_*.py",
                "**/*_test.py",
                "**/conftest.py",
                "**/Tests/**",
                "**/*Tests.swift"
            ]
        }
    }
}
