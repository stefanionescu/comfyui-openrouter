#!/usr/bin/env bash
#
# Check that browser files match their source.
# Runtime: Bash 3.2+ on macOS or Linux.
#MISE description="Check that browser files match their source."
set -euo pipefail

# main - Check that browser files match their source.
main() {
    REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
    cd "${REPO_ROOT}" || exit 1

    exec uv run --no-sync python -m scripts.frontend --check "$@"
}

main "$@"
