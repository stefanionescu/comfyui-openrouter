#!/usr/bin/env bash
#
# Check Python source structure, imports, documentation, and dependencies.
# Runtime: Bash 3.2+, macOS and Linux.
#MISE description="Check Python source structure, imports, documentation, and dependencies."
set -euo pipefail

# main - Check Python source structure, imports, documentation, and dependencies.
main() {
  REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
  cd "${REPO_ROOT}" || exit 1

  uv run --no-sync ruff check .
  uv run --no-sync python -m quality.python.runner
  uv run --no-sync lint-imports --cache-dir .artifacts/import-linter
  uv run --no-sync pydoclint --allow-init-docstring true __init__.py src scripts quality
  uv run --no-sync interrogate --fail-under 100 __init__.py src scripts quality
  uv run --no-sync deptry .
  uv run --no-sync vulture __init__.py src scripts quality
}

main "$@"
